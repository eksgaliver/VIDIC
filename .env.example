# ==============================================================================
# Srikaya Platform &middot; Master Environment Variables Example
# ==============================================================================

# Identitas & Penamaan Aplikasi
APP_NAME=Srikaya Enterprise
VITE_APP_NAME=Srikaya Enterprise

# Port Layanan Mikroservis
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
SHIFTING_SERVICE_PORT=3003
STORAGE_SERVICE_PORT=3002
CLIENT_PORT=5173

# URL Komunikasi Antar-Layanan
AUTH_SERVICE_URL=http://localhost:3001
SHIFTING_SERVICE_URL=http://localhost:3003
STORAGE_SERVICE_URL=http://localhost:3002
VITE_API_URL=http://localhost:3000/api

# Koneksi Basis Data PostgreSQL (Drizzle ORM)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/srikaya_auth

# Kunci Keamanan Token JWT (HMAC-SHA256)
JWT_SECRET=srikaya-enterprise-jwt-secret-key-2026

